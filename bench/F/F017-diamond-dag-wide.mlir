// RUN: dr-opt %s --pass-pipeline='builtin.module(data-recomputation{dr-test-diagnostics})' -verify-diagnostics

// F017: Binary DAG with depth 8 — fan-out from one root value.
// Tests analysis with wide DAG-shaped operand trees.

module {
  func.func @diamond_dag_wide(%arg0: i32) -> i32 {
    %buf = memref.alloc() : memref<i32>
    %c1 = arith.constant 1 : i32
    %c2 = arith.constant 2 : i32
    %d0_0 = arith.addi %arg0, %c1 : i32
    %d1_0 = arith.addi %d0_0, %c1 : i32
    %d1_1 = arith.addi %d0_0, %c2 : i32
    %d2_0 = arith.addi %d1_0, %c1 : i32
    %d2_1 = arith.addi %d1_0, %c2 : i32
    %d2_2 = arith.addi %d1_1, %c1 : i32
    %d2_3 = arith.addi %d1_1, %c2 : i32
    %d3_0 = arith.addi %d2_0, %c1 : i32
    %d3_1 = arith.addi %d2_0, %c2 : i32
    %d3_2 = arith.addi %d2_1, %c1 : i32
    %d3_3 = arith.addi %d2_1, %c2 : i32
    %d3_4 = arith.addi %d2_2, %c1 : i32
    %d3_5 = arith.addi %d2_2, %c2 : i32
    %d3_6 = arith.addi %d2_3, %c1 : i32
    %d3_7 = arith.addi %d2_3, %c2 : i32
    %d4_0 = arith.addi %d3_0, %c1 : i32
    %d4_1 = arith.addi %d3_0, %c2 : i32
    %d4_2 = arith.addi %d3_1, %c1 : i32
    %d4_3 = arith.addi %d3_1, %c2 : i32
    %d4_4 = arith.addi %d3_2, %c1 : i32
    %d4_5 = arith.addi %d3_2, %c2 : i32
    %d4_6 = arith.addi %d3_3, %c1 : i32
    %d4_7 = arith.addi %d3_3, %c2 : i32
    %d4_8 = arith.addi %d3_4, %c1 : i32
    %d4_9 = arith.addi %d3_4, %c2 : i32
    %d4_10 = arith.addi %d3_5, %c1 : i32
    %d4_11 = arith.addi %d3_5, %c2 : i32
    %d4_12 = arith.addi %d3_6, %c1 : i32
