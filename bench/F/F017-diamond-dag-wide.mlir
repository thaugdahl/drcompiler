    %d6_30 = arith.addi %d5_15, %c1 : i32
    %d6_31 = arith.addi %d5_15, %c2 : i32
    %d7_0 = arith.addi %d6_0, %c1 : i32
    %d7_1 = arith.addi %d6_0, %c2 : i32
    %d7_2 = arith.addi %d6_1, %c1 : i32
    %d7_3 = arith.addi %d6_1, %c2 : i32
    %d7_4 = arith.addi %d6_2, %c1 : i32
    %d7_5 = arith.addi %d6_2, %c2 : i32
    %d7_6 = arith.addi %d6_3, %c1 : i32
    %d7_7 = arith.addi %d6_3, %c2 : i32
    %d7_8 = arith.addi %d6_4, %c1 : i32
    %d7_9 = arith.addi %d6_4, %c2 : i32
    %d7_10 = arith.addi %d6_5, %c1 : i32
    %d7_11 = arith.addi %d6_5, %c2 : i32
    %d7_12 = arith.addi %d6_6, %c1 : i32
    %d7_13 = arith.addi %d6_6, %c2 : i32
    %d7_14 = arith.addi %d6_7, %c1 : i32
    %d7_15 = arith.addi %d6_7, %c2 : i32
    %d7_16 = arith.addi %d6_8, %c1 : i32
    %d7_17 = arith.addi %d6_8, %c2 : i32
    %d7_18 = arith.addi %d6_9, %c1 : i32
    %d7_19 = arith.addi %d6_9, %c2 : i32
    %d7_20 = arith.addi %d6_10, %c1 : i32
    %d7_21 = arith.addi %d6_10, %c2 : i32
    %d7_22 = arith.addi %d6_11, %c1 : i32
    %d7_23 = arith.addi %d6_11, %c2 : i32
    %d7_24 = arith.addi %d6_12, %c1 : i32
    %d7_25 = arith.addi %d6_12, %c2 : i32
    %d7_26 = arith.addi %d6_13, %c1 : i32
    %d7_27 = arith.addi %d6_13, %c2 : i32
    %d7_28 = arith.addi %d6_14, %c1 : i32
    %d7_29 = arith.addi %d6_14, %c2 : i32
    %d7_30 = arith.addi %d6_15, %c1 : i32
    %d7_31 = arith.addi %d6_15, %c2 : i32
    %m0 = arith.addi %d7_0, %d7_1 : i32
    %m1 = arith.addi %d7_2, %d7_3 : i32
    %m2 = arith.addi %d7_4, %d7_5 : i32
    %m3 = arith.addi %d7_6, %d7_7 : i32
    %m4 = arith.addi %d7_8, %d7_9 : i32
    %m5 = arith.addi %d7_10, %d7_11 : i32
    %m6 = arith.addi %d7_12, %d7_13 : i32
    %m7 = arith.addi %d7_14, %d7_15 : i32
    %m8 = arith.addi %m0, %m1 : i32
    %m9 = arith.addi %m2, %m3 : i32
    %m10 = arith.addi %m4, %m5 : i32
    %m11 = arith.addi %m6, %m7 : i32
    %m12 = arith.addi %m8, %m9 : i32
    %m13 = arith.addi %m10, %m11 : i32
    %m14 = arith.addi %m12, %m13 : i32
    memref.store %m14, %buf[] : memref<i32>
    // expected-remark @below {{load: SINGLE}}
    %out = memref.load %buf[] : memref<i32>
    memref.dealloc %buf : memref<i32>
    return %out : i32
